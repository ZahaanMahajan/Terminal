# Generated by Terminal. Edit the setup, not this file.

# Environment
export EDITOR="nvim"
export PATH="$HOME/bin:$PATH"

# Options
setopt AUTO_CD
setopt HIST_IGNORE_DUPS

# Plugins
[ -f "$HOME/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && source "$HOME/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
[ -f "$HOME/.zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.zsh" ] && source "$HOME/.zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.zsh"

# Aliases
alias gs='git status'
alias ll='eza -la --git'

# Prompt
eval "$(starship init zsh)"
