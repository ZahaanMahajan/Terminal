{
  "name": "@termi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Terminal's tiny REST backend — SQLite persistence, hand-rolled OAuth+sessions, app-owned migrations (localhost only for now).",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
